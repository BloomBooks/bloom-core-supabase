{
  "name": "bloom-supabase-bloom-core",
  "version": "1.0.0",
  "description": "Bloom Core Supabase project (supabase-bloom-core)",
  "packageManager": "pnpm@11.5.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "supabase start && pnpm dev:functions",
    "dev:debug": "supabase start && pnpm dev:functions:debug",
    "dev:functions": "supabase functions serve",
    "dev:functions:debug": "supabase functions serve --inspect",
    "stop": "supabase stop",
    "restart": "supabase stop && supabase start",
    "status": "supabase status",
    "reset": "supabase db reset",
    "deploy": "supabase functions deploy",
    "deploy:fs": "supabase functions deploy fs",
    "supabase": "supabase",
    "test": "deno test --allow-all supabase/functions/tests/*-test.ts --env-file=.env.local",
    "test:secrets-optional": "deno test --allow-all supabase/functions/tests/*-test.ts --env-file=.env.local -- --secrets-optional",
    "test:ci": "deno test --allow-all --frozen supabase/functions/tests/*-test.ts -- --secrets-optional",
    "test:watch": "deno test --allow-all --watch supabase/functions/tests/*-test.ts --env-file=.env.local"
  },
  "keywords": [
    "supabase",
    "edge-functions",
    "api"
  ],
  "license": "MIT",
  "devDependencies": {
    "supabase": "2.109.1"
  }
}
