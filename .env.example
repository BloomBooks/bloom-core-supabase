# Copy this file to .env.local and fill in your actual values

# Parse Server Configuration for Bloom Library
BLOOM_PARSE_APP_ID_PROD=
BLOOM_PARSE_APP_ID_DEV=
BLOOM_PARSE_APP_ID_UNIT_TEST=

# subscriptionInfo function (Google Sheets service account)
BLOOM_GOOGLE_SERVICE_ACCOUNT_EMAIL=
BLOOM_GOOGLE_SERVICE_PRIVATE_KEY=
BLOOM_SUBSCRIPTION_SPREADSHEET_ID=

# contentfulToCrowdin function (values from Azure; names standardized — mapping in MIGRATION-PLAN.md)
BLOOM_CONTENTFUL_READ_ONLY_TOKEN=
BLOOM_CROWDIN_API_TOKEN=
# Opt-in to real Crowdin uploads. Leave unset/blank everywhere except production:
# the function reads Contentful and logs the string counts, but only uploads to
# the real Crowdin project when this is exactly "true". Keeps local dev and
# staging from writing to Crowdin by accident.
BLOOM_CONTENTFUL_TO_CROWDIN_ENABLE_UPLOAD=
# shared secret required to invoke scheduled functions (any random string)
BLOOM_CRON_SECRET=

# opds function (value from Azure; name standardized — mapping in MIGRATION-PLAN.md)
BLOOM_PARSE_CATALOG_SERVICE_PASSWORD=
# opds live tests only
BLOOM_PARSE_API_ACCOUNT_OBJECT_ID_UNIT_TEST=

# books function (values from Azure; names standardized — mapping in MIGRATION-PLAN.md)
BLOOM_PARSE_SUPER_USER_PASSWORD_PROD=
BLOOM_PARSE_SUPER_USER_PASSWORD_DEV=

# bookCleanup function (values from Azure; names standardized — mapping in MIGRATION-PLAN.md)
BLOOM_PARSE_BOOK_CLEANUP_PASSWORD_PROD=
BLOOM_PARSE_BOOK_CLEANUP_PASSWORD_DEV=
BLOOM_PARSE_BOOK_CLEANUP_PASSWORD_UNIT_TEST=
BLOOM_UPLOAD_PERMISSION_MANAGER_S3_ACCESS_KEY_ID_PROD=
BLOOM_UPLOAD_PERMISSION_MANAGER_S3_SECRET_ACCESS_KEY_PROD=
BLOOM_UPLOAD_PERMISSION_MANAGER_S3_ACCESS_KEY_ID_DEV=
BLOOM_UPLOAD_PERMISSION_MANAGER_S3_SECRET_ACCESS_KEY_DEV=
BLOOM_UPLOAD_PERMISSION_MANAGER_S3_ACCESS_KEY_ID_UNIT_TEST=
BLOOM_UPLOAD_PERMISSION_MANAGER_S3_SECRET_ACCESS_KEY_UNIT_TEST=

# stats function: analytics Postgres, standard libpq variables (read-only user)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
